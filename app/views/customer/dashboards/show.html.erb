<div class="page-header">
  <h1>My Service Requests</h1>
  <p>Welcome, <%= current_user.email %></p>
</div>

<div class="dashboard-grid">
  <div class="dashboard-card">
    <h2>My Requests</h2>
    <p>Track the status of your device repairs.</p>
    <%= link_to "View My Requests", customer_service_requests_path, class: "btn btn--primary" %>
  </div>

  <div class="dashboard-card">
    <h2>New Request</h2>
    <p>Submit a new device for repair.</p>
    <%= link_to "Submit Request", new_customer_service_request_path, class: "btn btn--cta" %>
  </div>
</div>
