<div class="auth-card">
  <div class="auth-card__brand">
    <span class="auth-card__logo">FixIT Hub</span>
    <p class="auth-card__tagline">Reset your password</p>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :email, "Email address" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "you@example.com" %>
    </div>

    <%= f.submit "Send reset instructions", class: "btn btn--primary btn--full btn--lg" %>
  <% end %>

  <div class="auth-links">
    <%= render "devise/shared/links" %>
  </div>
</div>
