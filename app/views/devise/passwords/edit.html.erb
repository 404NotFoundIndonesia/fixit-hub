<div class="auth-card">
  <div class="auth-card__brand">
    <span class="auth-card__logo">FixIT Hub</span>
    <p class="auth-card__tagline">Choose a new password</p>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="form-group">
      <%= f.label :password, "New password" %>
      <% if @minimum_password_length %>
        <span class="form-hint"><%= @minimum_password_length %> characters minimum</span>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", placeholder: "••••••••" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "Confirm new password" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "••••••••" %>
    </div>

    <%= f.submit "Change password", class: "btn btn--primary btn--full btn--lg" %>
  <% end %>

  <div class="auth-links">
    <%= render "devise/shared/links" %>
  </div>
</div>
