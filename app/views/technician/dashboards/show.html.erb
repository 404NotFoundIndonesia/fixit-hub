<div class="page-header">
  <div>
    <h1 class="page-header__title">My Queue</h1>
    <p style="margin:4px 0 0;font-size:14px;color:var(--c-text-2);">Welcome back, <%= current_user.email %></p>
  </div>
  <%= link_to "View All Requests", technician_service_requests_path, class: "btn btn--primary" %>
</div>

<%# Quick stats %>
<% my_open      = current_user.assigned_service_requests.where(status: [:assigned, :in_diagnosis, :in_repair]).count %>
<% my_completed = current_user.assigned_service_requests.completed.count %>
<% in_repair    = current_user.assigned_service_requests.in_repair.count %>

<div class="dashboard-grid" style="margin-bottom:32px;">
  <div class="dashboard-card dashboard-card--stat">
    <div class="dashboard-card__stat"><%= my_open %></div>
    <div class="dashboard-card__label">Active Requests</div>
  </div>
  <div class="dashboard-card dashboard-card--stat">
    <div class="dashboard-card__stat dashboard-card__stat--alert"><%= in_repair %></div>
    <div class="dashboard-card__label">In Repair</div>
  </div>
  <div class="dashboard-card dashboard-card--stat">
    <div class="dashboard-card__stat dashboard-card__stat--success"><%= my_completed %></div>
    <div class="dashboard-card__label">Completed</div>
  </div>
</div>

<div class="dashboard-grid">
  <div class="dashboard-card">
    <h2>Assigned Requests</h2>
    <p>View and update the status of your assigned repairs.</p>
    <%= link_to "Open Queue", technician_service_requests_path, class: "btn btn--primary" %>
  </div>
</div>
