<!DOCTYPE html>
<html>
  <head>
    <title>FixIT Hub</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="layout-customer">
    <nav class="navbar" data-controller="nav">
      <div class="navbar__brand">
        <%= link_to "FixIT Hub", customer_dashboard_path, class: "navbar__logo" %>
      </div>

      <button class="navbar__toggle" data-action="click->nav#toggle" aria-label="Toggle navigation">&#9776;</button>

      <div class="navbar__links" data-nav-target="menu">
        <%= link_to "My Requests",    customer_service_requests_path,          class: "navbar__link" %>
        <%= link_to "New Request",    new_customer_service_request_path,       class: "navbar__link navbar__link--cta" %>
        <div class="navbar__divider"></div>
        <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "navbar__link navbar__link--signout" %>
      </div>
    </nav>

    <main class="main-content">
      <% if notice.present? %>
        <p class="flash flash--notice"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="flash flash--alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
