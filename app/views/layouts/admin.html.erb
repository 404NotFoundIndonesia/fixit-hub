<!DOCTYPE html>
<html>
  <head>
    <title>FixIT Hub &mdash; Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="layout-admin">
    <nav class="navbar" data-controller="nav">
      <div class="navbar__brand">
        <%= link_to "FixIT Hub", admin_dashboard_path, class: "navbar__logo" %>
        <span class="navbar__role-badge">Admin</span>
      </div>

      <button class="navbar__toggle" data-action="click->nav#toggle" aria-label="Toggle navigation">&#9776;</button>

      <div class="navbar__links" data-nav-target="menu">
        <%= link_to "Dashboard",    admin_dashboard_path,           class: "navbar__link" %>
        <%= link_to "Service Queue", admin_service_requests_path,   class: "navbar__link" %>
        <%= link_to "Technicians",  admin_users_path,               class: "navbar__link" %>
        <%= link_to "Customers",    admin_customers_path,           class: "navbar__link" %>
        <%= link_to "Analytics",    admin_analytics_path,           class: "navbar__link" %>
        <div class="navbar__divider"></div>
        <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "navbar__link navbar__link--signout" %>
      </div>
    </nav>

    <main class="main-content">
      <% if notice.present? %>
        <p class="flash flash--notice"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="flash flash--alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
