# Git
.git
.gitignore

# Logs and temp files
log/*
tmp/*
!tmp/.keep

# Test artifacts
coverage/
.byebug_history

# Node / build output (not applicable here but safe to ignore)
node_modules/

# Docker files themselves
.dockerignore
docker-compose*.yml

# macOS
.DS_Store

# Editor metadata
.idea/
.vscode/

# Environment files (never bake secrets into images)
.env
.env.*
!.env.*.example

# Storage (uploaded files — use object storage in prod)
storage/*
!storage/.keep

# SQLite test DB
db/*.sqlite3
db/*.sqlite3-*
