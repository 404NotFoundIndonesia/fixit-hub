# ── App domain (must match your DNS A record) ─────────────────────────────────
APP_DOMAIN=fixit-hub.yourdomain.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=fixit_hub
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=fixit_hub_production
POSTGRES_HOST=db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1

# ── Rails ─────────────────────────────────────────────────────────────────────
# Generate with: bundle exec rails secret
SECRET_KEY_BASE=changeme_run_rails_secret_to_generate

# Required to decrypt config/credentials.yml.enc
# Copy from config/master.key (keep secret, never commit)
RAILS_MASTER_KEY=changeme
